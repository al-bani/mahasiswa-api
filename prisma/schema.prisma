generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mahasiswa {
  nim           Int       @id @default(autoincrement())
  name          String
  email         String
  phone_number  String
  fakultas      String
  jurusan       String
  gender        String
  image         String
  subdistrict   String?
  birth         DateTime?
  city          String?
  created_at    DateTime  @default(now())
  district      String?
  province      String?
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  email    String @unique
  password String
  status   Int    @default(0)
}
